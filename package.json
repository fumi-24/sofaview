{
  "name": "sofaview",
  "version": "0.1.0",
  "private": true,
  "description": "テレビのリモコンだけで YouTube と TVer を操作する Chromium 拡張機能",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "test:live": "LIVE=1 node --test --test-concurrency=1 \"tests/live/*.test.mjs\"",
    "check": "node tools/check.mjs",
    "icons": "node tools/make-icons.mjs",
    "pack": "node tools/pack.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
