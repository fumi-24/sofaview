{
  "manifest_version": 3,
  "name": "SofaView",
  "version": "0.1.0",
  "description": "テレビのリモコン（十字キー・Enter・Esc・Home）だけで YouTube と TVer を操作する。",
  "minimum_chrome_version": "111",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://youtube.com/*",
    "https://youtu.be/*",
    "https://tver.jp/*",
    "https://open.spotify.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "SofaView の設定",
    "default_popup": "popup/popup.html"
  },
  "options_page": "hub/settings.html",
  "declarative_net_request": {
    "rule_resources": [
      { "id": "yt-ua", "enabled": true, "path": "rules/youtube-ua.json" },
      { "id": "yt-redirect", "enabled": false, "path": "rules/youtube-redirect.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/tv*"],
      "js": ["sites/youtube/ua-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/tv*"],
      "js": ["sites/youtube/receiver-main.js", "sites/youtube/exit-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/tv*"],
      "css": ["common/tokens.css", "common/base.css", "sites/youtube/youtube.css"],
      "js": [
        "common/sv.js",
        "common/cursor.js",
        "common/settings.js",
        "common/keys.js",
        "sites/youtube/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["https://tver.jp/*"],
      "js": ["sites/tver/ua-main.js", "sites/tver/billboard-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://tver.jp/*"],
      "css": ["common/tokens.css", "common/base.css", "common/osk.css", "sites/tver/tver.css", "sites/tver/watch.css"],
      "js": [
        "common/sv.js",
        "common/cursor.js",
        "common/settings.js",
        "common/keys.js",
        "common/zoom.js",
        "common/spatial-nav.js",
        "common/rows.js",
        "common/watch-core.js",
        "common/osk.js",
        "sites/tver/selectors.js",
        "sites/tver/watch.js",
        "sites/tver/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["https://open.spotify.com/*"],
      "css": ["common/tokens.css", "common/base.css", "common/osk.css", "sites/spotify/spotify.css", "sites/spotify/nowplaying.css"],
      "js": [
        "common/sv.js",
        "common/cursor.js",
        "common/settings.js",
        "common/keys.js",
        "common/zoom.js",
        "common/spatial-nav.js",
        "common/osk.js",
        "sites/spotify/selectors.js",
        "sites/spotify/nowplaying.js",
        "sites/spotify/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
